# Database Configuration (matches docker-compose.yml defaults)
POSTGRES_DB=scouting
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout
DATABASE_URL=postgresql+psycopg://scout:scout@db:5432/scouting

# API Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.trycloudflare.com
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin
CORS_ALLOW_CREDENTIALS=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# Cloudflare Tunnel Configuration
# Get this token from Cloudflare Zero Trust Dashboard -> Access -> Tunnels
# Leave empty to disable tunnel, or add your token here
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Auto-create database tables on startup
AUTO_CREATE_TABLES=
